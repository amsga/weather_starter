{
  "name": "weather-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "node scripts/dev.mjs",
    "docs": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "npm run build -w frontend && tsc -p backend/tsconfig.json",
    "start": "node scripts/start.mjs",
    "doctor": "node scripts/doctor.mjs",
    "format": "prettier --write \"frontend/**/*\" \"backend/**/*\" \"scripts/**/*\" \"*.json\" \"*.md\" \"*.mjs\" \"*.ts\" --ignore-unknown",
    "lint": "eslint \"frontend/src/**/*.{ts,tsx}\" \"frontend/*.config.{js,ts,mjs}\" \"backend/src/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs,ts}\" \"*.ts\" \"*.mjs\" --ignore-pattern \"frontend/dist/**\" --ignore-pattern \"backend/dist/**\" --ignore-pattern \"backend/drizzle/meta/**\"",
    "reset": "node scripts/reset.mjs",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:watch": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "dependencies": {
    "@astrojs/starlight": "^0.36.0",
    "@vitejs/plugin-react": "^5.1.4",
    "astro": "^5.14.0",
    "astro-mermaid": "^2.0.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "mermaid": "^11.12.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "portless": "^0.12.0",
    "sharp": "^0.34.0",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "playwright": "^1.60.0",
    "prettier": "3.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  }
}
